includes:
    # extension-installer auto-includes szepeviktor/phpstan-wordpress.
    # Do NOT manually include extension.neon — it causes a duplicate-include crash.

parameters:
    level: 6
    paths:
        - src/
    excludePaths:
        - tests/*
    tmpDir: .phpstan-cache

    # Load stubs for plugin constants, WooCommerce, and WP_CLI.
    # These are not provided by the WordPress extension.
    # Two files: global namespace + WP_CLI\Utils namespace (PHP requires
    # namespace to be first statement in file).
    bootstrapFiles:
        - phpstan-stubs.php
        - phpstan-stubs-wpcli.php
