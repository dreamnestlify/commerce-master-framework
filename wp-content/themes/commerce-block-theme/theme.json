{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "defaultPalette": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "custom": true,
            "customGradient": true,
            "customDuotone": true,
            "palette": [
                {
                    "slug": "base",
                    "name": "Base",
                    "color": "#ffffff"
                },
                {
                    "slug": "contrast",
                    "name": "Contrast",
                    "color": "#111111"
                },
                {
                    "slug": "ink",
                    "name": "Ink",
                    "color": "#1a1a1a"
                },
                {
                    "slug": "slate",
                    "name": "Slate",
                    "color": "#6b7280"
                },
                {
                    "slug": "mist",
                    "name": "Mist",
                    "color": "#f3f4f6"
                },
                {
                    "slug": "stone",
                    "name": "Stone",
                    "color": "#e5e7eb"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#c026d3"
                },
                {
                    "slug": "accent-light",
                    "name": "Accent Light",
                    "color": "#fae8ff"
                }
            ],
            "gradients": [
                {
                    "slug": "gradient-mist",
                    "name": "Mist Gradient",
                    "gradient": "linear-gradient(180deg, #ffffff 0%, #f3f4f6 100%)"
                },
                {
                    "slug": "gradient-dark",
                    "name": "Dark Gradient",
                    "gradient": "linear-gradient(180deg, #1a1a1a 0%, #000000 100%)"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "customLineHeight": true,
            "customTextDecoration": true,
            "customFontStyle": true,
            "customFontWeight": true,
            "customLetterSpacing": true,
            "customTextTransform": true,
            "dropCap": false,
            "fontFamilies": [
                {
                    "slug": "primary",
                    "name": "Primary (Sans)",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                {
                    "slug": "secondary",
                    "name": "Secondary (Serif)",
                    "fontFamily": "'Georgia', 'Times New Roman', serif"
                },
                {
                    "slug": "mono",
                    "name": "Mono",
                    "fontFamily": "'SF Mono', 'Monaco', 'Consolas', monospace"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Small",
                    "size": "0.875rem"
                },
                {
                    "slug": "medium",
                    "name": "Medium",
                    "size": "1rem"
                },
                {
                    "slug": "large",
                    "name": "Large",
                    "size": "1.25rem"
                },
                {
                    "slug": "x-large",
                    "name": "X-Large",
                    "size": "1.5rem"
                },
                {
                    "slug": "xx-large",
                    "name": "XX-Large",
                    "size": "2.25rem"
                },
                {
                    "slug": "xxx-large",
                    "name": "XXX-Large",
                    "size": "3rem"
                }
            ]
        },
        "spacing": {
            "customSpacingSize": true,
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "slug": "20",
                    "name": "1",
                    "size": "0.5rem"
                },
                {
                    "slug": "30",
                    "name": "2",
                    "size": "1rem"
                },
                {
                    "slug": "40",
                    "name": "3",
                    "size": "1.5rem"
                },
                {
                    "slug": "50",
                    "name": "4",
                    "size": "2rem"
                },
                {
                    "slug": "60",
                    "name": "5",
                    "size": "3rem"
                },
                {
                    "slug": "70",
                    "name": "6",
                    "size": "4rem"
                },
                {
                    "slug": "80",
                    "name": "7",
                    "size": "6rem"
                }
            ],
            "units": ["px", "em", "rem", "vh", "vw", "%"]
        },
        "layout": {
            "contentSize": "840px",
            "wideSize": "1280px"
        },
        "border": {
            "customColor": true,
            "customRadius": true,
            "customStyle": true,
            "customWidth": true
        },
        "shadow": {
            "customShadow": true,
            "defaultPresets": true
        },
        "position": {
            "fixed": false,
            "sticky": true
        }
    },
    "styles": {
        "color": {
            "background": "#ffffff",
            "text": "#111111"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--primary)",
            "fontSize": "1rem",
            "lineHeight": "1.6"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--primary)",
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xxx-large)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--accent)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--contrast)",
                    "text": "var(--wp--preset--color--base)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                "border": {
                    "radius": "0"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--accent)"
                    }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontSize": "1.5rem",
                    "fontWeight": "700"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em"
                }
            },
            "core/post-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "lineHeight": "1.3"
                }
            },
            "core/query-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "page-wide",
            "title": "Wide Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-blank",
            "title": "Blank Page (No Header/Footer)",
            "postTypes": ["page"]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "checkout-header",
            "title": "Checkout Header",
            "area": "header"
        }
    ]
}
