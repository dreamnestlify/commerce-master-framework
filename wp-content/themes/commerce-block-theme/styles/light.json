{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Minimal Light",
    "description": "Ultra-clean white minimalist aesthetic with soft grays.",
    "styles": {
        "color": {
            "background": "#fafafa",
            "text": "#1a1a1a"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#1a1a1a"
                },
                ":hover": {
                    "color": {
                        "text": "#71717a"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "#1a1a1a",
                    "text": "#ffffff"
                },
                "border": {
                    "radius": "0"
                },
                ":hover": {
                    "color": {
                        "background": "#3f3f46"
                    }
                }
            }
        }
    },
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "base",
                    "name": "Base",
                    "color": "#fafafa"
                },
                {
                    "slug": "contrast",
                    "name": "Contrast",
                    "color": "#1a1a1a"
                },
                {
                    "slug": "slate",
                    "name": "Slate",
                    "color": "#71717a"
                },
                {
                    "slug": "mist",
                    "name": "Mist",
                    "color": "#f4f4f5"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#71717a"
                }
            ]
        }
    }
}
