# ──────────────────────────────────────────────
# WordPress core (managed via Docker, not committed)
# ──────────────────────────────────────────────
/wordpress/
/wp/
/wp-cli.local.yml

# ──────────────────────────────────────────────
# Environment & secrets
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret
*.key
*.pem

# ──────────────────────────────────────────────
# Database & uploads (never commit user data)
# ──────────────────────────────────────────────
*.sql
*.sql.gz
*.sql.bz2
/db-data/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/backups/

# ──────────────────────────────────────────────
# Composer / PHP dependencies
# (lock files ARE committed for reproducible builds)
# ──────────────────────────────────────────────
/vendor/
/wp-content/plugins/commerce-core/vendor/

# ──────────────────────────────────────────────
# Node / npm dependencies
# ──────────────────────────────────────────────
/node_modules/
/wp-content/themes/commerce-block-theme/node_modules/

# ──────────────────────────────────────────────
# Build artifacts
# ──────────────────────────────────────────────
/dist/
/build/
*.min.js
*.min.css
*.map
*.zip
/wp-content/themes/commerce-block-theme/build/

# ──────────────────────────────────────────────
# Editor / OS
# ──────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# ──────────────────────────────────────────────
# Test / coverage
# ──────────────────────────────────────────────
/coverage/
/.phpunit.cache/
/.phpunit.result.cache

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
/logs/

# ──────────────────────────────────────────────
# WorkBuddy workspace metadata (internal, not source code)
# ──────────────────────────────────────────────
.workbuddy/

# ──────────────────────────────────────────────
# Local tool version management (mise, etc.)
# ──────────────────────────────────────────────
mise.toml
.mise.toml
