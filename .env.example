# ════════════════════════════════════════════════
# Commerce Master — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ════════════════════════════════════════════════

# ── WordPress Database ──
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_me_root_in_production
DB_HOST=db:3306
DB_TABLE_PREFIX=wp_

# ── WordPress Site ──
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# ── WordPress Keys & Salts (generate: https://api.wordpress.org/secret-key/1.1/salt/) ──
AUTH_KEY=generate_me
SECURE_AUTH_KEY=generate_me
LOGGED_IN_KEY=generate_me
NONCE_KEY=generate_me
AUTH_SALT=generate_me
SECURE_AUTH_SALT=generate_me
LOGGED_IN_SALT=generate_me
NONCE_SALT=generate_me

# ── Brand / Site Configuration ──
BRAND_NAME=Commerce Master
BRAND_TAGLINE=Fashion for the modern world
DEFAULT_LOCALE=en_US
BASE_CURRENCY=USD
ENABLED_CURRENCIES=USD,EUR,GBP
DEFAULT_MARKET=EU

# ── Support Contact ──
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=

# ── Analytics Placeholders (fill when ready) ──
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_ADS_ID=

# ── Payment (sandbox only in Phase 0; do not use real keys) ──
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── SMTP / Email (optional, for local testing) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── ERP / Inventory (future, Phase 4) ──
ERP_API_URL=
ERP_API_KEY=

# ── Docker Ports ──
HTTP_PORT=8080
HTTPS_PORT=8443
PMA_PORT=8090
XDEBUG_PORT=9003
