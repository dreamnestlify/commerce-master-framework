# ──────────────────────────────────────────────
# Caddyfile — Commerce Master Production
#
# Caddy automatically provisions and renews TLS certificates
# via Let's Encrypt. No manual cert management needed.
#
# Replace {$DOMAIN} with your real domain in .env
# ──────────────────────────────────────────────

{$DOMAIN}, www.{$DOMAIN} {
    # Reverse proxy to WordPress container
    reverse_proxy wordpress:80

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Remove Caddy version header
        -Server
    }

    # Gzip compression
    encode gzip

    # Cache static assets
    @static {
        path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.eot *.ico *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # WordPress-specific: don't cache PHP or admin
    @nocache {
        path *.php /wp-admin/* /wp-login.php /xmlrpc.php /wp-json/*
    }
    header @nocache Cache-Control "no-cache, no-store, must-revalidate"

    # Access log
    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 10
        }
    }
}

# Note: www and root domain are both served above.
# To redirect www → root instead, remove www from the block above
# and uncomment the redirect below:
# www.{$DOMAIN} {
#     redir https://{$DOMAIN}{uri} permanent
# }
