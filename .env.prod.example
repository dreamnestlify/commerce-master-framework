# ════════════════════════════════════════════════
# Commerce Master — PRODUCTION Environment
# Copy to .env and fill in real values.
#
# Usage:
#   cp .env.prod.example .env
#   # Edit .env with your real domain, passwords, keys
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# ⚠️  NEVER commit the real .env file.
# ════════════════════════════════════════════════

# ── Domain (CRITICAL — must be your real domain) ──
DOMAIN=your-domain.com
WP_HOME=https://your-domain.com
WP_SITEURL=https://your-domain.com

# ── WordPress Database ──
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_ROOT_PASSWORD=CHANGE_ME_root_password_here
DB_TABLE_PREFIX=wp_

# ── WordPress Admin ──
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_min_12_chars_strong
ADMIN_EMAIL=your-real-email@example.com

# ── WordPress Keys & Salts (CRITICAL) ──
# Generate with: openssl rand -hex 32
# Or: https://api.wordpress.org/secret-key/1.1/salt/
# Each MUST be different. No special chars (! @ # $ etc.).
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# ── Brand / Site Configuration ──
BRAND_NAME=Your Brand Name
BRAND_TAGLINE=Your brand tagline
DEFAULT_LOCALE=en_US
BASE_CURRENCY=USD
ENABLED_CURRENCIES=USD,EUR,GBP
DEFAULT_MARKET=EU

# ── Support Contact ──
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=

# ── Payment (LIVE keys for production) ──
# Get from:
#   Stripe: https://dashboard.stripe.com/apikeys
#   PayPal: https://developer.paypal.com/dashboard/applications/live
# Leave empty if payment not ready yet — site works without it.
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── SMTP / Email (recommended for production) ──
# Without SMTP, WordPress cannot send order confirmations or password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Your Brand Name

# ── Analytics (optional) ──
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_ADS_ID=

# ── ERP / Inventory (future, Phase 4) ──
ERP_API_URL=
ERP_API_KEY=
